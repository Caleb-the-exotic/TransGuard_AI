# ==============================================================================
# TransGuard AI – Environment Configuration
# ==============================================================================

# API Service Configuration (services/api)
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Frontend Configuration (apps/web)
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws/telemetry

# PostgreSQL & TimescaleDB Configuration (services/api)
# Note: If PostgreSQL is not reachable, TransGuard API automatically falls back
# to its internal in-memory repository with full state preservation.
DATABASE_URL=postgresql://transguard:transguard123@localhost:5432/transguard_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transguard_db
DB_USER=transguard
DB_PASSWORD=transguard123

# Eclipse Mosquitto MQTT Broker (services/api)
# If MQTT is not reachable, internal hardware simulator feeds telemetry seamlessly.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=transguard
MQTT_PASSWORD=transguard_secret
MQTT_TOPIC_PREFIX=transguard

# AI & Predictive Analytics Engine (services/ai-engine)
AI_ENGINE_URL=http://localhost:8000

# Security / Authentication
JWT_SECRET=transguard_industrial_jwt_secret_key_2026
JWT_EXPIRY=24h
